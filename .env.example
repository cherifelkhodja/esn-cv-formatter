# -----------------------------------------------------------------------------
# API Google Gemini
# -----------------------------------------------------------------------------
# Clé API obtenue depuis Google AI Studio : https://aistudio.google.com/
# ATTENTION : Ne jamais commiter le fichier .env contenant cette clé !
GEMINI_API_KEY=votre_cle_api_gemini_ici
